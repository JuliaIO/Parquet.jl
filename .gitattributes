# Conformance fixtures and their manifests are content hashed, so a CRLF checkout
# would change their digests. Keep every text file LF in the working tree on all
# platforms, and never translate the binary fixtures.
* text=auto eol=lf
*.parquet -text
*.parq -text
test/datasets/**/_common_metadata -text

# Generated by `julia thrift/generate.jl`; regenerate rather than edit.
src/metadata/parquet.jl linguist-generated=true
